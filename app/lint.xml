<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!-- Code Style and Formatting -->
    <issue id="HardcodedText" severity="warning" />
    <issue id="TypographyDashes" severity="warning" />
    <issue id="TypographyQuotes" severity="warning" />

    <!-- Performance Pitfalls -->
    <issue id="DrawAllocation" severity="error" />
    <issue id="UseCompoundDrawables" severity="warning" />
    <issue id="HandlerLeak" severity="error" />
    <issue id="Recycle" severity="error" />
    <issue id="Wakelock" severity="warning" />
    <issue id="UnusedResources" severity="warning" />

    <!-- Security & Best Practices -->
    <issue id="SetJavaScriptEnabled" severity="warning" />
    <issue id="TrustAllX509TrustManager" severity="error" />
    <issue id="ExportedPreferenceActivity" severity="error" />

    <!-- Project Specific Overrides -->
    <issue id="IconMissingDensityFolder" severity="ignore" />
    <issue id="ObsoleteLintCustomCheck" severity="ignore" />

    <!--
        Dependency version advisories are intentionally scoped to the version catalog.
        Kotlin Compose 2.4.x requires a coordinated Kotlin/KSP/Room migration; OkHttp 5.x
        and LiteRT 2.x are major upgrades that require API and runtime compatibility testing.
        The current versions are explicitly build-verified and the upgrades remain tracked
        as release-blocking compatibility work rather than being applied speculatively.
    -->
    <issue id="NewerVersionAvailable">
        <ignore path="../gradle/libs.versions.toml" />
    </issue>
    <issue id="GradleDependency">
        <ignore path="../gradle/libs.versions.toml" />
    </issue>
</lint>
