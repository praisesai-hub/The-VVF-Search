<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and device-transfer policy: no application data is exported.
    This is intentional because the app manages encrypted vault data and
    authentication state whose restore/key lifecycle is not supported here.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
